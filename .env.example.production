# App
APP_ENV=production
APP_PORT=8000
FRONTEND_URL=https://app.yourdomain.com
APP_URL=https://app.yourdomain.com
ALLOWED_ORIGINS=https://app.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com

# Database
POSTGRES_DB=launchpad
POSTGRES_USER=launchpad
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://launchpad:change-me@postgres:5432/launchpad
POSTGRES_URL=postgresql://launchpad:change-me@postgres:5432/launchpad

# Redis / queues / realtime coordination
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=replace-with-64-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Engage Clouds communication provider
ENGAGECLOUD_API_KEY=
ENGAGECLOUD_API_SECRET=
ENGAGECLOUD_AGENCY_ID=
ENGAGE_CLOUD_WEBHOOK_SECRET=
ENGAGECLOUD_FROM_NUMBERS=
ENGAGECLOUD_USE_NEW_AUTH=false
ENGAGECLOUD_API_BASE_URL=https://api.engage.so/v1
ENGAGECLOUD_SMS_SOURCE=engage_cloud
# Configure this in Engage Clouds:
# Messaging webhook: https://api.yourdomain.com/api/v1/webhooks/engage-clouds

# Legacy Twilio values, only for historical migration data or provider-side routing metadata
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# AI / LLM
OLLAMA_BASE_URL=http://ollama-gpu.internal:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=

# Analytics / vector search
CLICKHOUSE_URL=http://clickhouse.internal:8123
CLICKHOUSE_DB=analytics
QDRANT_URL=http://qdrant.internal:6333

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com

# Logging / observability
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# AWS / storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Rate limits
RATE_LIMIT_LOGIN=5/5min
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_API_GENERAL=100/min
RATE_LIMIT_SMS_SEND=10/min
SMS_PER_LEAD_PER_DAY=3
SMS_PER_LEAD_INTERVAL_SECONDS=60
SMS_PER_TENANT_PER_HOUR=100
SMS_GLOBAL_PER_HOUR=1000
