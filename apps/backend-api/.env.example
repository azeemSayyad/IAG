
# --- SignWell e-signature (onboarding agreement + W-9 embedded signing) ---
# API key from SignWell -> Settings -> API. Required for the sign step.
SIGNWELL_API_KEY=
# Template IDs (already set as defaults in config; override here if they change).
SIGNWELL_AGREEMENT_TEMPLATE_ID=ee00ece2-c285-4e28-8751-45b2d356be87
SIGNWELL_W9_TEMPLATE_ID=70643684-1019-4ae6-b13d-c3d6dad90b88
# Must match the placeholder/signer name set in the templates.
SIGNWELL_PLACEHOLDER_NAME=Agent
# Optional: API application id that whitelists embedded-signing domains.
SIGNWELL_API_APP_ID=
# true = non-billable test documents while developing (free plan = 25 real/mo).
SIGNWELL_TEST_MODE=false
# Path (relative to backend-api/) to the agency authorized-signature PNG used to
# counter-stamp the completed agreement after the agent signs.
SIGNWELL_AGENCY_SIGNATURE_PATH=app/onboarding/assets/agency_signature.png
