{
  "manifest_version": 3,
  "name": "IAG HealthSherpa Assistant",
  "short_name": "IAG HealthSherpa",
  "version": "1.0.0",
  "description": "Runs the HealthSherpa 2027 client-authorization steps for Insurance Alliance Group agents, started from the IAG portal.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "IAG HealthSherpa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.healthsherpa.com/*",
    "https://healthsherpa.com/*",
    "https://portal.iagplans.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.healthsherpa.com/*",
        "https://healthsherpa.com/*"
      ],
      "js": [
        "common.js",
        "hs.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.iagplans.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "common.js",
        "portal.js"
      ],
      "run_at": "document_start"
    }
  ]
}
