# Launchpad Call Center local environment
# Copy to .env and fill real secrets manually. Do not commit real values.

NODE_ENV=development
PORT=8000
APP_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500,http://127.0.0.1:3000
AUTH_ENABLED=true

POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/launchpad
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=CHANGE_ME_LOCAL_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=60m

ENGAGECLOUD_API_KEY=YOUR_ENGAGE_CLOUD_API_KEY
ENGAGECLOUD_API_SECRET=YOUR_ENGAGE_CLOUD_API_SECRET
ENGAGECLOUD_AGENCY_ID=YOUR_ENGAGE_CLOUD_AGENCY_ID
ENGAGE_CLOUD_WEBHOOK_SECRET=YOUR_ENGAGE_CLOUD_WEBHOOK_SECRET
ENGAGECLOUD_FROM_NUMBERS=+1XXXXXXXXXX
ENGAGECLOUD_USE_NEW_AUTH=false

MY_NUMBER_CHIP_ENABLED=false
CHAT_TANK_ENABLED=false
INBOUND_THREAD_ROUTING_ENABLED=true
SEED_AGENT_LIMIT=10

MAIL_USER=YOUR_SMTP_USERNAME
MAIL_PASS=YOUR_SMTP_PASSWORD
EMAIL_IMAP_PASSWORD=YOUR_IMAP_PASSWORD
EMAIL_SYSTEM_USER_ID=YOUR_EMAIL_SYSTEM_USER_ID

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_BUCKET_NAME=YOUR_S3_BUCKET_NAME

STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY

TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_AGENT_USER_ID=
TWILIO_SYSTEM_USER_ID=
