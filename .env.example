# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchpad
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Engage Clouds
ENGAGECLOUD_API_KEY=
ENGAGECLOUD_API_SECRET=
ENGAGECLOUD_AGENCY_ID=
ENGAGE_CLOUD_WEBHOOK_SECRET=
ENGAGECLOUD_FROM_NUMBERS=
ENGAGECLOUD_USE_NEW_AUTH=false
ENGAGECLOUD_API_BASE_URL=https://eu.app.api.sinch.com/v1
ENGAGECLOUD_SMS_SOURCE=messagemedia
PUBLIC_API_URL=http://localhost:8000

# Applicant Inbox: the "from" number admins text job applicants from. No live
# provider is wired yet, so messages are recorded locally with this as the sender.
APPLICANT_SMS_FROM_NUMBER=1111111111

# Legacy Twilio values, only for historical migration data or provider-side routing metadata
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# AI / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BUCKET_NAME=

# Google Calendar (optional — leave empty to disable)
GOOGLE_CALENDAR_CREDENTIALS=

# App
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
APP_URL=http://localhost:3000

# Scheduling (agent ET source of truth)
AGENT_TZ=America/New_York
SCHEDULING_SKIP_WEEKENDS=true
SCHEDULING_AUTO_ROLLOVER=true

# TCPA compliance (built + hooked, DISABLED by default; flip to true to enforce)
TCPA_ENABLED=false
